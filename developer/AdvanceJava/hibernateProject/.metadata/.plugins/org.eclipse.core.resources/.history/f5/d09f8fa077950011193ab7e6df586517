		EntityManagerFactory emf=Persistence.createEntityManagerFactory("Saq");
		EntityManager e=emf.createEntityManager();
		EntityTransaction et=e.getTransaction();
		et.begin();
		e.persist(laptop);
		et.commit();
	}
